                  <stringProp name="Argument.value">{&quot;message&quot;:&quot;Place an order for 1 x ${c_product_name}&quot;,&quot;session_id&quot;:&quot;${c_session_id}&quot;,&quot;message_id&quot;:&quot;msg-${__UUID}&quot;}</stringProp>
