  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="06 Day36-37 JSR223 Verify Token Prometheus" enabled="true">
      <stringProp name="TestPlan.comments">Class Day 36/37: JSR223 Assertion verifies place-order JSON; JSR223 logs tokens + failures; Prometheus text file demo for Pushgateway/Grafana later.</stringProp>
