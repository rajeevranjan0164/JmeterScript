            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assert place-order (Groovy)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
def fails = []
if (!body) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Empty place-order response body')
  return
}

def json
try {
  json = new JsonSlurper().parseText(body)
} catch (Exception e) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Response is not JSON: ' + e.message)
  return
}

// Day 35: HTTP 200 is not business success
if (!(json.message?.toString()?.contains('Order placed successfully'))) {
  fails &lt;&lt; 'message must contain \&quot;Order placed successfully\&quot; (got: ' + json.message + ')'
}
if (json.trace?.clarification == true) {
  fails &lt;&lt; 'trace.clarification must be false (agent asked a question instead of ordering)'
}
if (json.trace?.outcome?.toString() != 'success') {
  fails &lt;&lt; 'trace.outcome must be success (got: ' + json.trace?.outcome + ')'
}

def order = json.entities?.order
if (order == null) {
  fails &lt;&lt; 'entities.order missing'
} else {
  if (!(order.id?.toString()?.startsWith('ORD-'))) fails &lt;&lt; 'entities.order.id missing/invalid'
  if (order.status?.toString() != 'Confirmed') fails &lt;&lt; 'entities.order.status must be Confirmed'
  if (order.cancellable != true) fails &lt;&lt; 'entities.order.cancellable must be true'
  if (order.total == null) fails &lt;&lt; 'entities.order.total missing'
  vars.put('c_order_id', order.id?.toString() ?: 'default')
  vars.put('c_order_status', order.status?.toString() ?: 'default')
  vars.put('c_order_total', order.total?.toString() ?: '0')
}

def product = json.entities?.product
if (product?.name == null) {
  fails &lt;&lt; 'entities.product.name missing'
} else {
  vars.put('c_product_ordered', product.name.toString())
}

def place = json.actions?.find { it.tool == 'place_order' }
if (place == null) {
  fails &lt;&lt; 'actions must include tool place_order'
} else if (place.result?.ok != true) {
  fails &lt;&lt; 'place_order.result.ok must be true'
}

// Token / cost / latency capture (Day 36)
def t = json.trace ?: [:]
vars.put('c_input_tokens', (t.input_tokens ?: 0).toString())
vars.put('c_output_tokens', (t.output_tokens ?: 0).toString())
vars.put('c_total_tokens', (t.total_tokens ?: 0).toString())
vars.put('c_cost', (t.estimated_cost_usd ?: 0).toString())
vars.put('c_latency_ms', (t.latency_ms ?: 0).toString())
vars.put('c_outcome', (t.outcome ?: 'default').toString())
vars.put('c_trace_id', (t.id ?: '').toString())

// Outlier hint (class: most ~2k tokens, some 8k) — warn in log only
try {
  def totalTok = (t.total_tokens ?: 0) as int
  if (totalTok &gt;= 8000) {
    log.warn('TOKEN OUTLIER total_tokens=' + totalTok + ' order=' + vars.get('c_order_id'))
  }
} catch (ignored) {}

if (fails) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('JSR223 place-order failed:\\n - ' + fails.join('\\n - '))
} else {
  AssertionResult.setFailure(false)
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 Log failures only" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.nio.file.*;
String path = &quot;C:/AI LLM Testing/Jmeter/Day27-Learning/data/failures_only.csv&quot;;
Path p = Paths.get(path);
if (!Files.exists(p)) { Files.write(p, (&quot;serial,timestamp,label,order_id,code,message\n&quot;).getBytes(&quot;UTF-8&quot;)); }
if (!prev.isSuccessful()) {
  String serial = String.valueOf(System.currentTimeMillis());
  String line = serial + &quot;,&quot; + serial + &quot;,&quot; + prev.getSampleLabel().replace(&quot;,&quot;,&quot; &quot;) + &quot;,&quot; +
    (vars.get(&quot;c_order_id&quot;) ?: &quot;&quot;) + &quot;,&quot; + prev.getResponseCode() + &quot;,&quot; +
    String.valueOf(prev.getResponseMessage()).replace(&quot;,&quot;,&quot; &quot;).replace(&quot;\n&quot;,&quot; &quot;) + &quot;\n&quot;;
  Files.write(p, line.getBytes(&quot;UTF-8&quot;), StandardOpenOption.APPEND);
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 Token Logger" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.nio.file.*;
String path = &quot;C:/AI LLM Testing/Jmeter/Day27-Learning/data/token_log.csv&quot;;
Path p = Paths.get(path);
if (!Files.exists(p)) { Files.write(p, (&quot;timestamp,thread,order_id,product,input_tokens,output_tokens,total_tokens,cost,latency_ms,outcome,trace_id\n&quot;).getBytes(&quot;UTF-8&quot;)); }
String line = System.currentTimeMillis() + &quot;,&quot; + ctx.getThread().getThreadName() + &quot;,&quot; +
  (vars.get(&quot;c_order_id&quot;) ?: &quot;&quot;) + &quot;,&quot; + (vars.get(&quot;c_product_ordered&quot;) ?: &quot;&quot;) + &quot;,&quot; +
  (vars.get(&quot;c_input_tokens&quot;) ?: &quot;0&quot;) + &quot;,&quot; + (vars.get(&quot;c_output_tokens&quot;) ?: &quot;0&quot;) + &quot;,&quot; +
  (vars.get(&quot;c_total_tokens&quot;) ?: &quot;0&quot;) + &quot;,&quot; + (vars.get(&quot;c_cost&quot;) ?: &quot;0&quot;) + &quot;,&quot; +
  (vars.get(&quot;c_latency_ms&quot;) ?: &quot;0&quot;) + &quot;,&quot; + (vars.get(&quot;c_outcome&quot;) ?: &quot;&quot;) + &quot;,&quot; +
  (vars.get(&quot;c_trace_id&quot;) ?: &quot;&quot;) + &quot;\n&quot;;
Files.write(p, line.getBytes(&quot;UTF-8&quot;), StandardOpenOption.APPEND);
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 Prometheus metrics demo (Day 37)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.nio.file.*;
String path = &quot;C:/AI LLM Testing/Jmeter/Day27-Learning/data/prometheus_push_demo.txt&quot;;
def inTok = vars.get('c_input_tokens') ?: '0';
def outTok = vars.get('c_output_tokens') ?: '0';
def totTok = vars.get('c_total_tokens') ?: '0';
def lat = vars.get('c_latency_ms') ?: '0';
def err = prev.isSuccessful() ? '0' : '1';
String body = '# HELP voltcart_ai_input_tokens Input tokens\n'
  + '# TYPE voltcart_ai_input_tokens gauge\n'
  + 'voltcart_ai_input_tokens ' + inTok + '\n'
  + '# HELP voltcart_ai_output_tokens Output tokens\n'
  + '# TYPE voltcart_ai_output_tokens gauge\n'
  + 'voltcart_ai_output_tokens ' + outTok + '\n'
  + '# HELP voltcart_ai_total_tokens Total tokens\n'
  + '# TYPE voltcart_ai_total_tokens gauge\n'
  + 'voltcart_ai_total_tokens ' + totTok + '\n'
  + '# HELP voltcart_ai_latency_ms Latency ms\n'
  + '# TYPE voltcart_ai_latency_ms gauge\n'
  + 'voltcart_ai_latency_ms ' + lat + '\n'
  + '# HELP voltcart_ai_errors Error flag\n'
  + '# TYPE voltcart_ai_errors gauge\n'
  + 'voltcart_ai_errors ' + err + '\n';
Files.write(Paths.get(path), body.getBytes(&quot;UTF-8&quot;));
try {
  def url = new URL('http://127.0.0.1:9091/metrics/job/voltcart_jmeter');
  def conn = url.openConnection();
  conn.setDoOutput(true);
  conn.setRequestMethod('POST');
  conn.setConnectTimeout(3000);
  conn.setReadTimeout(5000);
  conn.setRequestProperty('Content-Type', 'text/plain; version=0.0.4; charset=utf-8');
  conn.getOutputStream().withWriter('UTF-8') { it &lt;&lt; body };
  def code = conn.getResponseCode();
  log.info('Pushgateway response code=' + code + ' total_tokens=' + totTok);
  if (code &lt; 200 || code &gt;= 300) { log.warn('Pushgateway push failed HTTP ' + code); }
} catch (Exception e) {
  log.warn('Pushgateway push error (is :9091 running?): ' + e.message);
}
</stringProp>
            </JSR223PostProcessor>
